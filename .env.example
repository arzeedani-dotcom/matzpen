# Postgres connection string (Vercel Postgres / Neon / any Postgres). On Neon use the pooled URL (host contains "-pooler")
DATABASE_URL=
# OpenAI API key — used only on the server
OPENAI_API_KEY=
# The single password for signing in
APP_PASSWORD=
# Recommended: 32+ random characters (e.g. openssl rand -base64 32). Signs the login cookie; changing it signs everyone out
SESSION_SECRET=
# Optional: override the agent model (default: gpt-6-luna)
OPENAI_MODEL=
# Optional: hard monthly ceiling for the agent in USD (default: 1)
AGENT_MONTHLY_BUDGET_USD=
# Optional: connections per server instance (default 3; use 1 for the local PGlite dev database)
DB_POOL_MAX=
